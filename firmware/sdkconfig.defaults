# ESP32-S3FH4R2: 4 MB Flash, 2 MB Quad PSRAM
# MiniNav-Mini — debloated for minimal hardware (no IMU, no cap-touch, no demo clip, no SD)

CONFIG_IDF_TARGET="esp32s3"

# --- Flash: 4 MB ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- CPU ---
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Cache ---
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y

# --- PSRAM: 2 MB Quad PSRAM (ESP32-S3FH4R2 uses Quad, not Octal) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
# Keep small allocations in internal RAM (faster); PSRAM for large buffers only
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# No PSRAM self-test → faster boot and less RAM wasted
# CONFIG_SPIRAM_MEMTEST is not set

# --- Console: Native USB (ESP32-S3 built-in USB-JTAG) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- H.264 decoder: single task (2 MB PSRAM is tight; dual-task needs more headroom) ---
CONFIG_ESP_H264_DECODER_IRAM=y
# CONFIG_ESP_H264_DUAL_TASK is not set

# --- Wi-Fi + TCP throughput (tuned down from original for 2 MB PSRAM budget) ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=8
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32
CONFIG_LWIP_TCP_MSS=1436

# --- Android Auto: TLS 1.2 on hardware crypto ---
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# --- Watchdog ---
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
# Core 1 runs the decode task and is legitimately busy; don't watch its idle task
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set

# --- Stack ---
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Boot speed ---
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y

# --- No DNS offered to phone (it must keep mobile data for Maps) ---
# CONFIG_LWIP_DHCPS_ADD_DNS is not set

# Wi-Fi AP & Hotspot Credentials
CONFIG_AAM_AP_SSID="RPM Loop"
CONFIG_AAM_AP_PASSWORD="88888888"
CONFIG_AAM_HOTSPOT_SSID="RPM Loop"
CONFIG_AAM_HOTSPOT_PASSWORD="88888888"

CONFIG_AAM_VIDEO_DENSITY=190
