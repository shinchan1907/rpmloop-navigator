ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('P3: USB-C relocated to bottom -Y at X=-27 beside TWO-finger camera mount. ESP32 cradle rotated and resized to clear enclosure walls. Widened 2.1 x 1.15 mm joint seal glands and uncompressed gasket masters included. 49 mm case depth excluding mount. Fit prototype only; actual active display/insert/USB interfaces remain unverified.'),'2;1');
FILE_NAME('housing.step','',(''),(''),'SolidCraft','SolidCraft','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF { 1 0 10303 442 1 1 4 }'));
ENDSEC;
